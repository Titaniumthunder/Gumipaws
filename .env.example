# ---------------------------------------------------------------------------
# GumiPaws environment variables
# Copy this file to `.env` and fill in the values. See README.md for how to
# obtain each one. Everything is read from env so the same code runs on
# Vercel, Netlify, or a VPS with no changes.
# ---------------------------------------------------------------------------

# Postgres connection string (Neon or Supabase). Use the "pooled" connection
# string for the app at runtime. For `prisma migrate` you may need the direct
# (non-pooled) URL — see DIRECT_URL below.
DATABASE_URL=
# Optional: direct (non-pooled) connection used only by `prisma migrate`.
# Neon/Supabase give you this alongside the pooled URL. Leave blank to reuse
# DATABASE_URL.
DIRECT_URL=

# Auth.js / NextAuth. Generate a secret with: `openssl rand -base64 32`
NEXTAUTH_SECRET=
# Full origin of the deployment, e.g. http://localhost:3000 in dev,
# https://gumipaws.vercel.app in production.
NEXTAUTH_URL=http://localhost:3000

# The initial ADMIN staff member, seeded by `npx prisma db seed`.
# Staff log in with a numeric PIN only (no email/password). ADMIN_PIN is 3–10
# digits; you can add more staff (each with an auto-generated 4-digit PIN) from
# the /admin/staff page once logged in.
ADMIN_NAME=
ADMIN_PIN=

# Google Calendar service account (writes bookings to one shared calendar).
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the private key including the BEGIN/END lines. Keep the literal "\n"
# escapes if your host stores it on one line — the code un-escapes them.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
# The calendar's ID (looks like an email). Share the calendar with the service
# account email above, giving it "Make changes to events" access.
GOOGLE_CALENDAR_ID=

# Resend transactional email.
RESEND_API_KEY=
# Where customer bookings are also emailed for the business to see.
BUSINESS_NOTIFICATION_EMAIL=
# The "from" address Resend sends as. Must be a verified domain/sender in
# Resend. Defaults to onboarding@resend.dev for quick local testing.
EMAIL_FROM="GumiPaws <onboarding@resend.dev>"
